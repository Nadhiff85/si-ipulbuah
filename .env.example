APP_NAME="IPUL BUAH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ipul_buah
DB_USERNAME=root
DB_PASSWORD=

# Sanctum SPA (Vue) - sesuaikan domain frontend Anda
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost

# Mail (Laravel Mail + SMTP) - fitur Notifikasi Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ipulbuah.com"
MAIL_FROM_NAME="${APP_NAME}"

# WaBlas API - fitur Notifikasi WhatsApp
WABLAS_API_KEY=
WABLAS_BASE_URL=https://console.wablas.com

FILESYSTEM_DISK=public
