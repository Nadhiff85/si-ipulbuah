APP_NAME="IPUL BUAH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ipul_buah
DB_USERNAME=root
DB_PASSWORD=

# Sanctum SPA (Vue) - sesuaikan domain frontend Anda
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=localhost

# Mail (Laravel Mail + SMTP) - fitur Notifikasi Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@ipulbuah.com"
MAIL_FROM_NAME="${APP_NAME}"

# WaBlas API - fitur Notifikasi WhatsApp
WABLAS_API_KEY=
WABLAS_BASE_URL=https://console.wablas.com

# Midtrans - integrasi QRIS otomatis (Sandbox dulu, ganti IS_PRODUCTION saat go-live)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Sama dengan MIDTRANS_CLIENT_KEY di atas - client key aman dipakai di frontend,
# tapi Vite butuh env terpisah berprefix VITE_ supaya ter-bundle ke Vue.
VITE_MIDTRANS_CLIENT_KEY=
VITE_MIDTRANS_IS_PRODUCTION=false

FILESYSTEM_DISK=public
